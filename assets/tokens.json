{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "The Rustic Barrel Taphouse",
  "version": "1.0.0",
  "description": "Design tokens for The Rustic Barrel Taphouse. Derived from pixel analysis of 6 designed flyers, 108 curated brand photographs, the official Canva menu, and 50 qualified Dribbble references. Every value is traceable to scraped evidence.",

  "meta": {
    "source": "Scrapling crawl + Pillow palette extraction",
    "extracted": "2026-10-11",
    "primaryEvidence": [
      "research/media/brand_marks/brand-*.jpg (6 designed flyers)",
      "research/media/brand_library/photos (108 curated brand frames)",
      "research/reference/qualified.json (50 qualified references)"
    ]
  },

  "color": {
    "primary": {
      "charred-oak":   { "$value": "#1F1610", "$type": "color", "$description": "Dominant ground. 33-56% of every designed flyer. H17 S41 L7." },
      "bone":          { "$value": "#F3EAD9", "$type": "color", "$description": "Primary light. All type on dark grounds. 7:1 on Charred Oak." },
      "barrel-navy":   { "$value": "#151B25", "$type": "color", "$description": "Secondary dark. Panels, ribbons, secondary headlines." },
      "weathered-wood":{ "$value": "#8B5633", "$type": "color", "$description": "Warm mid. Plank grounds, rules, texture." }
    },
    "accent": {
      "amber-gold":    { "$value": "#ED9F0F", "$type": "color", "$description": "Accent 1. Chili-cheese focal, availability, price. ACCENT ONLY - fails AA as a text background on Bone." },
      "oxblood":       { "$value": "#6B1F1F", "$type": "color", "$description": "Accent 2. Urgency, sold-out, closures." },
      "burnt-amber":   { "$value": "#A25713", "$type": "color", "$description": "Accent 3. Deep warm secondary fills." },
      "brass":         { "$value": "#B08B54", "$type": "color", "$description": "Accent 4. Added from reference analysis - reads as barrel-hoop and tap-handle metal. Rules, badge borders, small metal cues." }
    },
    "support": {
      "barley":        { "$value": "#D3B48D", "$type": "color", "$description": "Parchment mid-tone, dividers." },
      "hop-green":     { "$value": "#4A6B2A", "$type": "color", "$description": "Beer/lager references only." },
      "smoke":         { "$value": "#2A211B", "$type": "color", "$description": "Card and panel elevation over Charred Oak." }
    },
    "ink": {
      "on-dark":       { "$value": "#F3EAD9", "$type": "color" },
      "on-dark-muted": { "$value": "#B7A794", "$type": "color", "$description": "7:1+ on Charred Oak. Secondary text." },
      "on-light":      { "$value": "#1F1610", "$type": "color" },
      "on-light-muted":{ "$value": "#5A4636", "$type": "color", "$description": "7.2:1 on Bone. Secondary text." },
      "outline":       { "$value": "#0D0806", "$type": "color", "$description": "Display-type outline / hard shadow." }
    }
  },

  "typography": {
    "family": {
      "display": {
        "$value": "'Rye', 'Rye Fallback', Georgia, serif",
        "$type": "fontFamily",
        "$description": "Western wood-type slab with spur serifs. Display only, >=24px, all caps, +2-4% tracking. Illegible below 24px."
      },
      "subhead": {
        "$value": "'Bevan', Georgia, 'Times New Roman', serif",
        "$type": "fontFamily",
        "$description": "Condensed western caps for subheads and rules."
      },
      "script": {
        "$value": "'Kaushan Script', 'Segoe Script', cursive",
        "$type": "fontFamily",
        "$description": "Brush script accent. ONE line per composition, never two. Never in body copy."
      },
      "body": {
        "$value": "'Barlow', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "$type": "fontFamily",
        "$description": "The face that does not exist in the current brand. All body, menus, legal, UI."
      }
    },
    "scale": {
      "display-xl": { "$value": "clamp(2.6rem, 6.4vw, 5rem)",  "$type": "dimension", "$description": "Hero word. Rye, caps. Capped at 5rem - at 6.5rem the wordmark wrapped to three lines and pushed the order CTA below the fold." },
      "display-l":  { "$value": "clamp(2rem, 4.6vw, 3.25rem)", "$type": "dimension", "$description": "Page h1." },
      "display-m":  { "$value": "clamp(1.75rem, 4vw, 2.75rem)", "$type": "dimension" },
      "display-s":  { "$value": "clamp(1.375rem, 3vw, 1.875rem)", "$type": "dimension" },
      "subhead-size": { "$value": "clamp(1.125rem, 2.4vw, 1.5rem)", "$type": "dimension", "$description": "Subhead size. Named distinctly from family.subhead so CSS references are unambiguous." },
      "body-l":     { "$value": "1.125rem", "$type": "dimension", "$description": "Default body size." },
      "body":       { "$value": "1rem", "$type": "dimension" },
      "body-s":     { "$value": "0.875rem", "$type": "dimension" },
      "label":      { "$value": "0.75rem", "$type": "dimension", "$description": "All-caps, tracked +0.12em." }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "tracking": {
      "caps":   { "$value": "0.03em", "$type": "dimension", "$description": "All-caps display, +2-4%." },
      "label":  { "$value": "0.12em", "$type": "dimension" },
      "tight":  { "$value": "-0.01em", "$type": "dimension" },
      "normal": { "$value": "0", "$type": "dimension" }
    },
    "leading": {
      "tight":  { "$value": "1.05", "$type": "number" },
      "snug":   { "$value": "1.25", "$type": "number" },
      "normal": { "$value": "1.6",  "$type": "number" },
      "loose":  { "$value": "1.75", "$type": "number" }
    }
  },

  "space": {
    "3xs": { "$value": "0.25rem", "$type": "dimension" },
    "2xs": { "$value": "0.5rem",  "$type": "dimension" },
    "xs":  { "$value": "0.75rem", "$type": "dimension" },
    "sm":  { "$value": "1rem",    "$type": "dimension" },
    "md":  { "$value": "1.5rem",  "$type": "dimension" },
    "lg":  { "$value": "2rem",    "$type": "dimension" },
    "xl":  { "$value": "3rem",    "$type": "dimension" },
    "2xl": { "$value": "4rem",    "$type": "dimension" },
    "3xl": { "$value": "6rem",    "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",      "$type": "dimension", "$description": "Badge, ribbon, sign board." },
    "sm":   { "$value": "3px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "14px",   "$type": "dimension" }
  },

  "border": {
    "hairline":  { "$value": "1px solid rgba(243, 234, 217, 0.14)", "$type": "border" },
    "brass":     { "$value": "1px solid #B08B54", "$type": "border" },
    "rope":      { "$value": "2px dashed rgba(176, 139, 84, 0.55)", "$type": "border", "$description": "Rope divider device." },
    "focus":     { "$value": "0 0 0 3px #1F1610, 0 0 0 5px #ED9F0F", "$type": "shadow", "$description": "Keyboard focus ring. Never remove." }
  },

  "shadow": {
    "badge":  { "$value": "0 2px 0 rgba(13, 8, 6, 0.9)", "$type": "shadow", "$description": "Hard offset - letterpress, never a soft blur." },
    "lift":   { "$value": "0 6px 24px rgba(13, 8, 6, 0.45)", "$type": "shadow" },
    "sign":   { "$value": "0 12px 32px rgba(13, 8, 6, 0.55)", "$type": "shadow" }
  },

  "motion": {
    "fast":   { "$value": "120ms", "$type": "duration" },
    "base":   { "$value": "220ms", "$type": "duration" },
    "slow":   { "$value": "400ms", "$type": "duration" },
    "ease":   { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" },
    "reduced":{ "$value": "0.01ms", "$type": "duration", "$description": "Under prefers-reduced-motion. All animation collapses to this." }
  },

  "breakpoint": {
    "sm": { "$value": "480px",  "$type": "dimension" },
    "md": { "$value": "768px",  "$type": "dimension" },
    "lg": { "$value": "1024px", "$type": "dimension" },
    "xl": { "$value": "1280px", "$type": "dimension" }
  },

  "layout": {
    "maxWidth":     { "$value": "1200px", "$type": "dimension" },
    "proseWidth":   { "$value": "68ch",  "$type": "dimension", "$description": "Body measure. Exceeding 75ch is the #1 readability failure." },
    "gutter":       { "$value": "clamp(1.25rem, 4vw, 3rem)", "$type": "dimension" },
    "tapTarget":    { "$value": "48px",   "$type": "dimension", "$description": "WCAG 2.5.5 minimum for all CTAs." }
  },

  "asset": {
    "logo": {
      "note": "The client's own engraved barrel artwork, EXTRACTED from the DoorDash store cover - never redrawn. See research/brand/logo_provenance.json.",
      "primaryMark": { "$value": "assets/img/logo-mark.png", "$type": "asset", "$description": "Faithful, white ground." },
      "primaryMarkDark": { "$value": "assets/img/logo-mark-dark.webp", "$type": "asset", "$description": "Same artwork, ground swapped to Charred Oak. Used on all dark surfaces." },
      "avatar": { "$value": "assets/img/logo-avatar.webp", "$type": "asset", "$description": "Square crop on the original paper ground. Favicon, PWA icon - anywhere a light plate is correct." },
      "avatarDark": { "$value": "assets/img/logo-avatar-dark.webp", "$type": "asset", "$description": "Square crop with the ground swapped to Charred Oak. Header only. Using the paper-ground avatar in the header rendered as a white box on the dark bar." },
      "appleTouch": { "$value": "assets/img/logo-icon-192.png", "$type": "asset" }
    },
    "og": { "$value": "assets/img/og-default.jpg", "$type": "asset", "$description": "1200x630." }
  },

